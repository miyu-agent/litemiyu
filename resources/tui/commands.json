{
  "commands": [
    {
      "name": "undo",
      "aliases": [
        "rewind"
      ],
      "summary": {
        "zh": "撤回上一轮",
        "en": "Undo the last turn"
      },
      "run": "revert"
    },
    {
      "name": "restore",
      "summary": {
        "zh": "恢复刚才撤回的一轮",
        "en": "Bring back the turn you just undid"
      },
      "run": "unrevert"
    },
    {
      "name": "redo",
      "summary": {
        "zh": "重新运行这一轮",
        "en": "Run this turn again"
      },
      "run": "redo"
    },
    {
      "name": "edit",
      "summary": {
        "zh": "编辑上一条消息并重新发送",
        "en": "Edit your last message and send it again"
      },
      "run": "edit"
    },
    {
      "name": "stop",
      "summary": {
        "zh": "停止这个会话中所有正在运行的任务",
        "en": "Stop everything running in this session"
      },
      "run": "stop"
    },
    {
      "name": "clear",
      "aliases": [
        "reset"
      ],
      "summary": {
        "zh": "清空上下文",
        "en": "Clear context"
      },
      "run": "clear"
    },
    {
      "name": "compact",
      "summary": {
        "zh": "立即压缩上下文，后面可以写摘要的要求",
        "en": "Compact the context now; anything after it guides the summary"
      },
      "run": "compact",
      "args": true
    },
    {
      "name": "rename",
      "summary": {
        "zh": "重命名会话；只输入 /rename 时由 AI 重新生成标题，/rename - 清除标题",
        "en": "Rename the session; /rename alone asks the AI for a new title, /rename - removes it"
      },
      "run": "rename",
      "args": true
    },
    {
      "name": "icons",
      "summary": {
        "zh": "换一套图标：nerd、plain 轮着换",
        "en": "Switch icons: nerd, plain in turn"
      },
      "run": "icons"
    },
    {
      "name": "new",
      "summary": {
        "zh": "开一个新会话，可以指定预设",
        "en": "Start a new session, optionally with a preset"
      },
      "run": "new",
      "args": true,
      "argument": {
        "zh": "[<预设名>]",
        "en": "[<preset>]"
      }
    },
    {
      "name": "preset",
      "summary": {
        "zh": "选择、新建、编辑预设",
        "en": "Choose, create and edit presets"
      },
      "run": "preset"
    },
    {
      "name": "delete",
      "summary": {
        "zh": "删除当前会话",
        "en": "Delete this session"
      },
      "run": "delete"
    },
    {
      "name": "sessions",
      "aliases": [
        "resume"
      ],
      "summary": {
        "zh": "列出会话并切换",
        "en": "List sessions and switch to one"
      },
      "run": "sessions"
    },
    {
      "name": "jump",
      "summary": {
        "zh": "列出你在这个会话里发过的消息并跳转",
        "en": "List your messages in this session and jump to one"
      },
      "run": "jump"
    },
    {
      "name": "files",
      "summary": {
        "zh": "查看这个会话修改过的文件和差异",
        "en": "See the files this session changed and their diffs"
      },
      "run": "files"
    },
    {
      "name": "model",
      "summary": {
        "zh": "更换这个会话的模型",
        "en": "Change this session's model"
      },
      "run": "model"
    },
    {
      "name": "effort",
      "summary": {
        "zh": "更改当前模型的思考程度",
        "en": "Change the current model's thinking effort"
      },
      "run": "effort"
    },
    {
      "name": "config",
      "aliases": [
        "settings"
      ],
      "summary": {
        "zh": "打开配置：供应商、模型",
        "en": "Open settings: providers, models"
      },
      "run": "config"
    },
    {
      "name": "status",
      "summary": {
        "zh": "查看这个会话的状态：模型、上下文、用量",
        "en": "Show this session's status: model, context, usage"
      },
      "run": "status"
    },
    {
      "name": "copy",
      "summary": {
        "zh": "复制上一轮的回答",
        "en": "Copy the last reply"
      },
      "run": "copy"
    },
    {
      "name": "help",
      "summary": {
        "zh": "查看按键和命令",
        "en": "See keys and commands"
      },
      "run": "help"
    },
    {
      "name": "export",
      "summary": {
        "zh": "导出这个会话",
        "en": "Export this session"
      },
      "run": "export"
    },
    {
      "name": "exit",
      "summary": {
        "zh": "退出",
        "en": "Exit"
      },
      "run": "quit"
    },
    {
      "name": "loop",
      "summary": {
        "zh": "循环执行",
        "en": "Run on a loop"
      },
      "run": "loop",
      "args": true,
      "argument": {
        "zh": "[<间隔>] <要说的话> | off",
        "en": "[<interval>] <prompt> | off"
      },
      "usage": [
        [
          {
            "zh": "/loop <间隔> <要说的话>",
            "en": "/loop <interval> <prompt>"
          },
          {
            "zh": "每隔一段时间说一次，例如 5m、2h",
            "en": "Send it at a fixed interval, such as 5m or 2h"
          }
        ],
        [
          {
            "zh": "/loop <要说的话>",
            "en": "/loop <prompt>"
          },
          {
            "zh": "由 AI 自己定下一次什么时候",
            "en": "Let the AI pick when to run next"
          }
        ],
        [
          {
            "zh": "/loop off",
            "en": "/loop off"
          },
          {
            "zh": "停止此会话的循环",
            "en": "Stop this session's loops"
          }
        ]
      ]
    }
  ]
}
